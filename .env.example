APP_NAME=enterprise-genai-platform
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Grounded answering is opt-in.
ANSWERING_ENABLED=false

# Retrieval serving mode.
# Supported values: local, grpc
RETRIEVAL_MODE=local

# Required when RETRIEVAL_MODE=grpc.
# Example:
# RETRIEVAL_GRPC_TARGET=127.0.0.1:50051
RETRIEVAL_GRPC_TARGET=

# Per-retrieval-RPC deadline in seconds.
RETRIEVAL_GRPC_DEADLINE_SECONDS=5.0

# Startup-only bounded gRPC channel reachability timeout in seconds.
RETRIEVAL_GRPC_STARTUP_TIMEOUT_SECONDS=5.0

POSTGRES_DB=enterprise_genai
POSTGRES_USER=enterprise_genai
POSTGRES_PASSWORD=enterprise_genai_dev

DATABASE_URL=postgresql+psycopg://enterprise_genai:enterprise_genai_dev@localhost:5432/enterprise_genai
